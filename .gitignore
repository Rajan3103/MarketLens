# Secret keys - never upload these
.env
.streamlit/secrets.toml

# Python leftovers
__pycache__/
*.pyc
.venv/
venv/

# Log files written by marketlens/logger.py
logs/

# Local downloads (the database itself lives in PostgreSQL, not in this folder)
data/*.csv
# the scheduler's NSE holiday list is part of the code
!data/nse_holidays.csv
# pg_dump backups (they contain all your data)
data/backups/
data/downloads/

# Dhan's instrument list (re-downloaded once a day)
data/dhan/
data/forward/
data/journal/

# pytest leftovers
.pytest_cache/

# Web frontend (Next.js): packages, build output and the private settings file
frontend/node_modules/
frontend/.next/
frontend/.env.local
