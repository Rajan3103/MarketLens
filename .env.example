# Copy this file to ".env" and fill in your own values.
# The .env file is private and is NOT uploaded to GitHub.
# Leave a line empty to use the default shown in brackets.
# Restart the app (Ctrl + C, then streamlit run app.py) after changing .env.

# ---- Dhan: the only broker and market-data API ----
# Your Dhan client ID (a number): web.dhan.co -> My Profile
DHAN_CLIENT_ID=
# Access token: web.dhan.co -> My Profile -> Access DhanHQ APIs -> Generate token.
# It lasts 24 hours, so paste a fresh one each day (or use the API key below later).
DHAN_ACCESS_TOKEN=
# OPTIONAL for an individual account: API key + secret (valid 12 months) for the
# automatic daily login. Create them in the same place on web.dhan.co.
DHAN_API_KEY=
DHAN_API_SECRET=

# ---- Telegram bot (create one with @BotFather) ----
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your own chat id (send a message to @userinfobot to see it)
TELEGRAM_CHAT_ID=

# ---- Webhooks: TradingView / Chartink alerts (module 7) ----
# A long random text (24+ characters) that every alert must contain; others are rejected.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Port the webhook receiver listens on [8000]
WEBHOOK_PORT=8000

# ---- Database: PostgreSQL only ----
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Replace CHANGE_ME with your real password (and the user/database names if yours differ).
# If the password has @ : / or % in it, write them as %40 %3A %2F %25.
DATABASE_URL=postgresql+psycopg://marketlens:CHANGE_ME@localhost:5432/marketlens
# A SEPARATE database only for pytest. Tests delete its data, so never point it at
# the real one. Empty = database tests are skipped.
TEST_DATABASE_URL=postgresql+psycopg://marketlens:CHANGE_ME@localhost:5432/marketlens_test

# ---- App ----
# Password to open the dashboard when it runs on a server (empty = no password)
DASHBOARD_PASSWORD=
# true = use clearly labelled DEMO data when a key is missing, false = show an error [true]
DEMO_MODE=true
# Where daily prices come from: yfinance (free, no key); dhan once the Dhan keys are added [yfinance]
DATA_SOURCE=yfinance
# Default folder for downloaded candle CSV files (module 3) [data/downloads]
# Example on Windows: C:/Users/you/Documents/MarketLens
DOWNLOAD_DIR=data/downloads

# ---- Trading safety ----
# paper = virtual money only, live = real money [paper]
TRADING_MODE=paper
# Virtual money the paper broker starts with, in rupees [500000]
PAPER_CAPITAL=500000
# true = strategies may place orders by themselves, false = you confirm each one [false]
AUTO_TRADE=false
# Stop all trading for the day after losing this many rupees [2000]
MAX_DAILY_LOSS_RS=2000
# Most orders the app may send in one second (broker limit) [5]
MAX_ORDERS_PER_SECOND=5
# Most positions open at the same time; new entries are blocked above this [5]
MAX_OPEN_POSITIONS=5

# ---- AWS server (later: remove the # when the app moves to AWS) ----
# Region of the server; ap-south-1 = Mumbai [ap-south-1]
# AWS_REGION=ap-south-1
# The server's Elastic (static) IP. Dhan only accepts orders from a whitelisted static IP
# (SEBI rule), so add this IP on web.dhan.co too. Reading market data works without it.
# SERVER_STATIC_IP=
