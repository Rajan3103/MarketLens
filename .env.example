# Copy this file to ".env" and fill in your own values.
# The .env file is private and is NOT uploaded to GitHub.

# Dhan broker API (from web.dhan.co -> My Profile -> DhanHQ Trading APIs)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Telegram bot (from @BotFather) and your own chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# paper = practice orders only, live = real money
TRADING_MODE=paper
