# Copy this file to ".env" and fill in your own values.
# The .env file is private and is NOT uploaded to GitHub.
# Leave a line empty to use the default shown in brackets.
# Restart the app (Ctrl + C, then streamlit run app.py) after changing .env.

# ---- Dhan broker (web.dhan.co -> My Profile -> DhanHQ Trading APIs) ----
# Your Dhan client ID (a number)
DHAN_CLIENT_ID=
# Access token; Dhan tokens expire, so paste a fresh one when it stops working
DHAN_ACCESS_TOKEN=

# ---- Upstox broker (account.upstox.com/developer/apps) ----
# API key of your Upstox app
UPSTOX_API_KEY=
# API secret of your Upstox app
UPSTOX_API_SECRET=
# Redirect URL you typed when creating the app, e.g. http://localhost:8501
UPSTOX_REDIRECT_URI=
# Access token from the Upstox login (expires every day)
UPSTOX_ACCESS_TOKEN=

# ---- Telegram bot (create one with @BotFather) ----
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your own chat id (send a message to @userinfobot to see it)
TELEGRAM_CHAT_ID=

# ---- App ----
# Password to open the dashboard when it runs on a server (empty = no password)
DASHBOARD_PASSWORD=
# Where the database lives [sqlite:///data/marketlens.db]
# Later for PostgreSQL: postgresql://user:password@host:5432/marketlens
DATABASE_URL=sqlite:///data/marketlens.db
# Where prices come from: yfinance (free, no key), later dhan or upstox [yfinance]
DATA_SOURCE=yfinance
# true = use sample data when a key is missing, false = show an error instead [true]
DEMO_MODE=true

# ---- Trading safety ----
# paper = practice orders only, live = real money [paper]
TRADING_MODE=paper
# true = strategies may place orders by themselves, false = you confirm each one [false]
AUTO_TRADE=false
# Stop all trading for the day after losing this many rupees [2000]
MAX_DAILY_LOSS_RS=2000
# Most orders the app may send in one second (broker limit) [5]
MAX_ORDERS_PER_SECOND=5
